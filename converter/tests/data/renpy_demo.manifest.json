  "items": [
    {
      "id": "bg-room-001",
      "type": "image",
      "file": "media/4e/4e31ed53f4e9c99c989189f6b0bcda70e59e3f22b3b16151cc53db95142f882e.jxl",
      "speaker": "Ana",
      "text": "Welcome to the house.",
      "audio": {
        "music": "theme",
        "ambience": [
          "rain"
        ],
        "fadeMs": 2000
      }
    },
    {
      "id": "line-002",
      "type": "text",
      "speaker": "Viktor",
      "text": "The lights are dim. [greeting]?",
      "audio": {
        "voice": "viktor-01"
      }
    },
    {
      "id": "line-003",
      "type": "text",
      "speaker": "Dmitri",
      "text": "The fire is low, but the room is warm.",
      "audio": {
        "sfx": [
          {
            "track": "door",
            "channel": "sound"
          }
        ]
      }
    },
    {
      "id": "clip-004",
      "type": "video",
      "file": "media/f3/f3f95674ec5ca4acac14de72647a1e926e99f11f852633d46e1b9073a8fd4e3f.mp4",
      "poster": "media/78/78417a2f84fc75e63ee5c5652fe4fd4769e6a5b7e052b1ee04e00b9fed105b96.jxl",
      "durationSeconds": 1.0,
      "speaker": "Ana",
      "text": "The screen flickers to life."
    },
    {
      "id": "line-005",
      "type": "text",
      "speaker": "Dmitri",
      "text": "Тени танцуют на стене."
    },
    {
      "id": "bg-yard-006",
      "type": "image",
      "file": "media/d2/d20230e78d6ef5fc7c196b9a2b29c126dc0567e474a7b621c9a001b83cc1b44e.jxl",
      "text": "Тишина в саду. [wind]"
    },
    {
      "id": "line-007",
      "type": "text",
      "speaker": "Гостья",
      "text": "It almost feels like home."
    },
    {
      "id": "bg-room-008",
      "type": "image",
      "file": "media/4e/4e31ed53f4e9c99c989189f6b0bcda70e59e3f22b3b16151cc53db95142f882e.jxl",
      "speaker": "Ana",
      "text": "The fire crackles as the room warms."
    },
    {
      "id": "line-009",
      "type": "text",
      "speaker": "Dmitri",
      "text": "Tea, then. The strong kind."
    },
    {
      "id": "bg-yard-010",
      "type": "image",
      "file": "media/d2/d20230e78d6ef5fc7c196b9a2b29c126dc0567e474a7b621c9a001b83cc1b44e.jxl",
      "speaker": "Гостья",
      "text": "The gravel sounds louder at night.",
      "audio": {
        "music": "theme-2",
        "ambience": [],
        "fadeMs": 1000
      }
    },
    {
      "id": "line-011",
      "type": "text",
      "text": "Somewhere past the hedge, water runs."
    },
    {
      "id": "line-012",
      "type": "text",
      "text": "The night settles over the house."
    },
    {
      "id": "line-013",
      "type": "text",
      "text": "Go back inside"
    },
    {
      "id": "line-014",
      "type": "text",
      "speaker": "Dmitri",
      "text": "The sky is impossibly wide."
    },
    {
      "id": "bg-room-015",
      "type": "image",
      "file": "media/4e/4e31ed53f4e9c99c989189f6b0bcda70e59e3f22b3b16151cc53db95142f882e.jxl",
      "speaker": "Ana",
      "text": "Back inside, where it is quiet."
    },
    {
      "id": "line-016",
      "type": "text",
      "speaker": "Dmitri",
      "text": "Good night."
    },
    {
      "id": "mislabel-bmp-017",
      "type": "image",
      "file": "media/76/766061c78f173b2148c2b73008b3807be584b2c7d3303271a74e6dd6fb05ebff.jxl",
      "speaker": "Ana",
      "text": "A small painting on the wall."
    },
    {
      "id": "mislabel-png-018",
      "type": "image",
      "file": "media/a0/a036d597c7e05081cefdce07aae1b742b412828d1a057122550198beebed306c.jxl",
      "text": "The frame beside it hides its true format too."
    },
    {
      "id": "bg-reprise-019",
      "type": "image",
      "file": "media/4e/4e31ed53f4e9c99c989189f6b0bcda70e59e3f22b3b16151cc53db95142f882e.jxl",
      "speaker": "Dmitri",
      "text": "The same room again, seen from the hall."
    },
    {
      "id": "photo-noise-020",
      "type": "image",
      "file": "media/ef/ef6b0278107596046cd6e0f11016e1492ecc56a5039e47b82d89ad76a54a4806.jxl",
      "speaker": "Ana",
      "text": "A photograph, grainy and warm."
    },
    {
      "id": "bg-gif-021",
      "type": "image",
      "file": "media/fd/fd849da0b478645ebd5dcf09a7f259ba2ec932ab90163b5c9fc376e6908f5ce9.gif",
      "text": "A tiny paper lantern blinks by the door."
    },
    {
      "id": "talk-022",
      "type": "video",
      "file": "media/7d/7dd5cee1ea4e38b3bbe5f372d3a9ad2ad5e25464725aeb08fb2b4a9ca2f4a9ca.mp4",
      "poster": "media/08/08df9d4410047764f5d58739a45aa3a14c8ef5318d17ab78f95c4708092f1b4f.jxl",
      "durationSeconds": 1.0,
      "speaker": "Dmitri",
      "text": "The television hums along. Then it falls silent.",
      "audio": {
        "videoSound": {
          "track": "talk"
        }
      }
    },
    {
      "id": "bg-room-023",
      "type": "image",
      "file": "media/4e/4e31ed53f4e9c99c989189f6b0bcda70e59e3f22b3b16151cc53db95142f882e.jxl",
      "speaker": "Ana",
      "text": "Something warm before bed?"
    },
    {
      "id": "line-024",
      "type": "text",
      "text": "Tea, please"
    },
    {
      "id": "line-025",
      "type": "text",
      "speaker": "Dmitri",
      "text": "I will melt the chocolate slowly."
    },
    {
      "id": "line-026",
      "type": "text",
      "speaker": "Dmitri",
      "text": "Take your time."
    },
    {
      "id": "line-027",
      "type": "text",
      "text": "You settle by the window with your cup."
    },
    {
      "id": "line-028",
      "type": "text",
      "speaker": "Dmitri",
      "text": "The tea is strong and dark."
    },
    {
      "id": "line-029",
      "type": "text",
      "speaker": "Dmitri",
      "text": "The cocoa is sweet and thick."
    },
    {
      "id": "line-030",
      "type": "text",
      "speaker": "Ana",
      "text": "The rain has stopped."
    },
    {
      "id": "line-031",
      "type": "text",
      "speaker": "Ana",
      "text": "The whole house feels warm now."
    },
    {
      "id": "line-032",
      "type": "text",
      "speaker": "Ana",
      "text": "One warm corner is enough."
    },
    {
      "id": "line-033",
      "type": "text",
      "speaker": "Ana",
      "text": "The cold creeps back in."
    },
    {
      "id": "candle-034",
      "type": "animation",
      "frames": [
        "media/05/056d24eefa035765253298862c620164bcdd6b42acd26390728ad8191b0b16cd.jxl",
        "media/6d/6d4504f1c32280edfca0130fafc48a1dda398a65653210d114fa196e328fdc10.jxl",
        "media/d9/d953ced4eee42fedb02f61fe9ae6a5cf55c7b8be92580cc320e21200c73eb375.jxl"
      ],
      "fps": 5.0,
      "frameSeconds": [
        0.3,
        0.15,
        0.15
      ],
      "loopCount": 2,
      "holdLastFrame": true,
      "speaker": "Ana",
      "text": "A candle gutters on the sill, then holds still."
    },
    {
      "id": "line-035",
      "type": "text",
      "text": "The house sleeps."
    }
  ],
