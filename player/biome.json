{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!dist",
      "!.vitest",
      "!.tmp",
      "!src/i18n/locales.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "puppeteer-core": "Start Chrome with launchChrome or launchBrowser from scripts/testing/core.mjs, which keep it silent."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/testing/core.mjs"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
