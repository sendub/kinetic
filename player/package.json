{
  "name": "kinetic-player",
  "version": "1.10.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Kinetic visual novel player (static web app, single classic bundle)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:map": "node scripts/mapperf.mjs",
    "perf:save": "node scripts/saveperf.mjs",
    "perf:sound": "node scripts/soundperf.mjs",
    "perf:decode": "node scripts/decodeperf.mjs",
    "package-proof": "node scripts/package-proof.mjs",
    "verify": "node scripts/build.mjs && node scripts/scenarios/run.mjs",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
