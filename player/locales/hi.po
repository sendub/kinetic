# Kinetic player: Hindi (hi).
# An unreviewed draft written by an AI model on 2026-11-16.
# Corrections are welcome: docs/verify-player.md, "The player's words".
msgid ""
msgstr ""
"Project-Id-Version: Kinetic player\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: hi\n"

#. Browser tab title when the game names itself nothing (the player's name).
msgctxt "page.title"
msgid "Kinetic"
msgstr "Kinetic"

#. Shown in place of the game when its files cannot be read; {detail} is a technical reason, in English.
#. Placeholders: {detail}.
msgctxt "error.load"
msgid "Could not load the content: {detail}"
msgstr "सामग्री लोड नहीं हो सकी: {detail}"

#. Esc screen: the heading over the grid of keys.
msgctxt "help.title"
msgid "Keys"
msgstr "कुंजियाँ"

#. Esc screen, title bar: the keys that close the screen.
#. Placeholders: {esc}, {space}.
msgctxt "help.hint"
msgid "{esc} or {space} closes"
msgstr "{esc} या {space} से बंद करें"

#. Esc screen, title bar: accessible name of the Language control, a button opening the list of the game's languages; {language} is the language shown now, named in itself (e.g. Deutsch).
#. Placeholders: {language}.
msgctxt "lang.control"
msgid "Language: {language}"
msgstr "भाषा: {language}"

#. Esc screen: accessible name of the open list of the game's languages (each named in itself).
msgctxt "lang.list"
msgid "Language"
msgstr "भाषा"

#. Pill when a language of the game cannot be read: the game stays in the language it was in. {language} is that language named in itself (e.g. Deutsch).
#. Placeholders: {language}.
msgctxt "lang.unavailable"
msgid "{language} could not be loaded"
msgstr "{language} लोड नहीं हो सकी"

#. Esc screen, bottom corner: the player's name and release ({version}, e.g. 1.10.0).
#. Placeholders: {version}.
msgctxt "help.kinetic"
msgid "Kinetic {version}"
msgstr "Kinetic {version}"

#. Esc screen, key grid: the cap drawn for the mouse wheel (one cap, short).
msgctxt "keys.wheel.cap"
msgid "wheel"
msgstr "व्हील"

#. Esc screen, key grid: what Space does (lower case, short).
msgctxt "keys.advance"
msgid "next item; stops auto-forward"
msgstr "अगला आइटम; स्वतः आगे बढ़ना रोकता है"

#. Esc screen, key grid: what the Left and Right arrows do.
msgctxt "keys.segments"
msgid "previous / next view of a video"
msgstr "वीडियो का पिछला / अगला दृश्य"

#. Esc screen, key grid: what the mouse wheel does.
msgctxt "keys.wheel"
msgid "back / forward through the story"
msgstr "कहानी में पीछे / आगे"

#. Esc screen, key grid: what E does.
msgctxt "keys.end"
msgid "jump to the furthest point read"
msgstr "सबसे आगे पढ़े गए स्थान पर जाएँ"

#. Esc screen, key grid: what U does.
msgctxt "keys.unseen"
msgid "next unseen content"
msgstr "अगली अनदेखी सामग्री"

#. Esc screen, key grid: what Tab does.
msgctxt "keys.skip"
msgid "skip what you have seen"
msgstr "देखा हुआ छोड़ें"

#. Esc screen, key grid: what A does.
msgctxt "keys.autoForward"
msgid "auto-forward on / off"
msgstr "स्वतः आगे बढ़ना चालू / बंद"

#. Esc screen, key grid: what H does.
msgctxt "keys.text"
msgid "hide / show the text"
msgstr "टेक्स्ट छिपाएँ / दिखाएँ"

#. Esc screen, key grid: what V does (games with sound).
msgctxt "keys.sound"
msgid "sound on / off"
msgstr "ध्वनि चालू / बंद"

#. Esc screen, key grid: what B does.
msgctxt "keys.bookmark"
msgid "bookmark this moment"
msgstr "इस पल को बुकमार्क करें"

#. Esc screen, key grid: what M does (a click on the row opens the map too).
msgctxt "keys.map"
msgid "branch map and bookmarks"
msgstr "शाखा मानचित्र और बुकमार्क"

#. Esc screen, key grid: what Esc does.
msgctxt "keys.escape"
msgid "this screen: keys and settings; closes the map"
msgstr "यह स्क्रीन: कुंजियाँ और सेटिंग्स; मानचित्र बंद करता है"

#. Esc screen, key grid: the keys at a decision (1-9, 0, arrows, Enter).
msgctxt "keys.decision"
msgid "at a decision: pick a route; 0 returns to main route"
msgstr "चुनाव पर: रास्ता चुनें; 0 मुख्य रास्ते पर लौटाता है"

#. Esc screen: the heading over the settings.
msgctxt "config.title"
msgid "Settings"
msgstr "सेटिंग्स"

#. Settings: the reading speed row's label (it paces auto-forward).
msgctxt "config.speed.label"
msgid "Auto-forward speed"
msgstr "स्वतः आगे बढ़ने की गति"

#. Settings: accessible name of the "?" after the speed label.
msgctxt "config.speed.about"
msgid "About auto-forward speed"
msgstr "स्वतः आगे बढ़ने की गति के बारे में"

#. Settings: the tip behind the speed's "?".
msgctxt "config.speed.tip"
msgid "Also times play-all's choice countdown."
msgstr "“सभी रास्ते चलाएँ” में चुनाव की उलटी गिनती का समय भी यही तय करती है।"

#. Settings: accessible name of the speed's minus button.
msgctxt "config.speed.decrease"
msgid "Decrease auto-forward speed"
msgstr "स्वतः आगे बढ़ने की गति घटाएँ"

#. Settings: accessible name of the speed's plus button.
msgctxt "config.speed.increase"
msgid "Increase auto-forward speed"
msgstr "स्वतः आगे बढ़ने की गति बढ़ाएँ"

#. Settings: the speed readout, small; {speed} is the multiplier (1.00), {ms} the milliseconds per character.
#. Placeholders: {speed}, {ms}.
msgctxt "config.speed.readout"
msgid "{speed}x (~{ms} ms/char)"
msgstr "{speed}x (~{ms} मि.से./अक्षर)"

#. Settings: the heading over the two options of how Tab skips ({tab} is the key).
#. Placeholders: {tab}.
msgctxt "config.skip.section"
msgid "When {tab} skips"
msgstr "{tab} से छोड़ते समय"

#. Settings: option under "When Tab skips": skipping also passes content never seen.
msgctxt "config.skip.all"
msgid "Skip unseen content too"
msgstr "अनदेखी सामग्री भी छोड़ें"

#. Settings: option under "When Tab skips": a skip plays each video in full.
msgctxt "config.skip.videos"
msgid "Play videos in full"
msgstr "वीडियो पूरे चलाएँ"

#. Settings: a switch's state, on (short).
msgctxt "config.on"
msgid "On"
msgstr "चालू"

#. Settings: a switch's state, off (short).
msgctxt "config.off"
msgid "Off"
msgstr "बंद"

#. Settings: the switch that makes every decision pick itself in turn.
msgctxt "config.playAll"
msgid "Play all routes"
msgstr "सभी रास्ते चलाएँ"

#. Settings: accessible name of the "?" after "Play all routes".
msgctxt "config.playAll.about"
msgid "About play all routes"
msgstr "सभी रास्ते चलाने के बारे में"

#. Settings: the tip behind "Play all routes"' "?".
msgctxt "config.playAll.tip"
msgid "When on, choices pick themselves on a countdown."
msgstr "चालू होने पर, उलटी गिनती के बाद चुनाव अपने आप हो जाते हैं।"

#. Settings: the Sound row's label (games with sound).
msgctxt "config.sound"
msgid "Sound"
msgstr "ध्वनि"

#. Settings: the button that opens the Volumes sheet.
msgctxt "config.sound.volumes"
msgid "Volumes…"
msgstr "वॉल्यूम…"

#. Settings: accessible name of the Volumes… button.
msgctxt "config.sound.volumesAria"
msgid "Sound volumes"
msgstr "ध्वनि वॉल्यूम"

#. Settings: the heading over Export, Import and Reset.
msgctxt "config.progress.section"
msgid "Progress"
msgstr "प्रगति"

#. Settings: after the Progress heading, dimmer: saving needs no action.
msgctxt "config.progress.saved"
msgid "saved automatically"
msgstr "अपने आप सहेजी जाती है"

#. Settings: accessible name of the "?" after the Progress heading.
msgctxt "config.progress.about"
msgid "About progress"
msgstr "प्रगति के बारे में"

#. Settings: the Export row's label.
msgctxt "config.export.label"
msgid "Export progress"
msgstr "प्रगति निर्यात करें"

#. Settings: the Export row's button (short).
msgctxt "config.export.button"
msgid "Export"
msgstr "निर्यात"

#. Settings: accessible name of the Export button.
msgctxt "config.export.aria"
msgid "Export this story's progress to a file"
msgstr "इस कहानी की प्रगति फ़ाइल में निर्यात करें"

#. Notice pill after an export (the file's name is not said).
msgctxt "config.export.done"
msgid "Progress exported"
msgstr "प्रगति निर्यात हो गई"

#. Settings: the Import row's label.
msgctxt "config.import.label"
msgid "Import progress"
msgstr "प्रगति आयात करें"

#. Settings: the Import row's button, which opens a file picker (short).
msgctxt "config.import.button"
msgid "Import…"
msgstr "आयात…"

#. Notice pill: the picked file could not be read at all.
msgctxt "config.import.unreadable"
msgid "That file could not be read."
msgstr "वह फ़ाइल पढ़ी नहीं जा सकी।"

#. Settings: the Reset row's label.
msgctxt "config.reset.label"
msgid "Reset progress"
msgstr "प्रगति रीसेट करें"

#. Settings: the Reset row's button, which opens a confirmation (short).
msgctxt "config.reset.button"
msgid "Reset…"
msgstr "रीसेट…"

#. Settings: accessible name of the Reset button.
msgctxt "config.reset.aria"
msgid "Reset all progress for this content"
msgstr "इस सामग्री की सारी प्रगति रीसेट करें"

#. Settings (in a browser tab): the tip behind the Progress "?".
msgctxt "wording.browser.progressTip"
msgid "Saved in this browser as you read. Export and Import carry it to another browser."
msgstr "पढ़ते समय इस ब्राउज़र में सहेजी जाती है। निर्यात और आयात से इसे दूसरे ब्राउज़र में ले जाएँ।"

#. Notice pill (browser tab): a confirmed import that storage refused.
msgctxt "wording.browser.importFailed"
msgid "The import failed: this browser's storage refused it. Nothing was changed."
msgstr "आयात विफल: इस ब्राउज़र के स्टोरेज ने इसे अस्वीकार कर दिया। कुछ नहीं बदला।"

#. Settings (browser tab): accessible name of the Import button.
msgctxt "wording.browser.importAria"
msgid "Import progress from a file, replacing this browser's"
msgstr "फ़ाइल से प्रगति आयात करें, इस ब्राउज़र की प्रगति की जगह"

#. Import confirmation (browser tab); {story} is the game's name or "this story".
#. Placeholders: {story}.
msgctxt "wording.browser.importConfirm"
msgid "Replace this browser's progress for {story} with the imported file?"
msgstr "इस ब्राउज़र में {story} की प्रगति को आयात की गई फ़ाइल से बदलें?"

#. Settings (game app): the tip behind the Progress "?".
msgctxt "wording.app.progressTip"
msgid "Saved as you read. Export and Import carry it to another device."
msgstr "पढ़ते समय सहेजी जाती है। निर्यात और आयात से इसे दूसरे डिवाइस पर ले जाएँ।"

#. Notice pill (game app): a confirmed import that storage refused.
msgctxt "wording.app.importFailed"
msgid "The import failed: this computer's storage refused it. Nothing was changed."
msgstr "आयात विफल: इस कंप्यूटर के स्टोरेज ने इसे अस्वीकार कर दिया। कुछ नहीं बदला।"

#. Settings (game app): accessible name of the Import button.
msgctxt "wording.app.importAria"
msgid "Import progress from a file, replacing the progress saved here"
msgstr "फ़ाइल से प्रगति आयात करें, यहाँ सहेजी गई प्रगति की जगह"

#. Import confirmation (game app); {story} is the game's name or "this story".
#. Placeholders: {story}.
msgctxt "wording.app.importConfirm"
msgid "Replace the progress saved here for {story} with the imported file?"
msgstr "यहाँ सहेजी गई {story} की प्रगति को आयात की गई फ़ाइल से बदलें?"

#. Import confirmation: stands for {story} when the game names itself nothing.
msgctxt "wording.thisStory"
msgid "this story"
msgstr "इस कहानी"

#. Settings: the heading over the window controls.
msgctxt "window.section"
msgid "Game window"
msgstr "गेम विंडो"

#. Settings, Game window: the label of the Fullscreen | Window switch (read by screen readers).
msgctxt "window.display"
msgid "Display"
msgstr "डिस्प्ले"

#. Settings, Game window: one half of the display switch.
msgctxt "window.fullscreen"
msgid "Fullscreen"
msgstr "पूर्ण स्क्रीन"

#. Settings, Game window: the other half of the display switch.
msgctxt "window.window"
msgid "Window"
msgstr "विंडो"

#. Settings, Game window: the button that quits (short).
msgctxt "window.exit"
msgid "Exit"
msgstr "बाहर निकलें"

#. Settings, Game window: the Exit row's label and the button's accessible name.
msgctxt "window.exitLabel"
msgid "Exit the game"
msgstr "गेम से बाहर निकलें"

#. Notice pill: a browser tab the page may not close.
msgctxt "window.closeTab"
msgid "This browser keeps the tab open: close the tab to exit."
msgstr "यह ब्राउज़र टैब खुला रखता है: बाहर निकलने के लिए टैब बंद करें।"

#. Confirmation box: the button that changes nothing.
msgctxt "confirm.cancel"
msgid "Cancel"
msgstr "रद्द करें"

#. Confirmation box, reset: its heading.
msgctxt "confirm.reset.title"
msgid "Reset progress"
msgstr "प्रगति रीसेट करें"

#. Confirmation box, reset: the question.
msgctxt "confirm.reset.message"
msgid "Reset all progress for this content? This clears resume position, seen items, routes, bookmarks and settings."
msgstr "इस सामग्री की सारी प्रगति रीसेट करें? इससे फिर से शुरू करने की जगह, देखे गए आइटम, रास्ते, बुकमार्क और सेटिंग्स मिट जाएँगी।"

#. Confirmation box, reset: the confirming button (short).
msgctxt "confirm.reset.button"
msgid "Reset"
msgstr "रीसेट करें"

#. Confirmation box, reset: the keys under the buttons.
#. Placeholders: {yes}, {esc}, {no}.
msgctxt "confirm.reset.hint"
msgid "{yes} resets; {esc} or {no} cancels"
msgstr "{yes} रीसेट; {esc} या {no} रद्द"

#. Confirmation box, import: its heading.
msgctxt "confirm.import.title"
msgid "Import progress"
msgstr "प्रगति आयात करें"

#. Confirmation box, import: the confirming button (short).
msgctxt "confirm.import.button"
msgid "Import"
msgstr "आयात करें"

#. Confirmation box, import: the keys under the buttons.
#. Placeholders: {yes}, {esc}, {no}.
msgctxt "confirm.import.hint"
msgid "{yes} imports; {esc} or {no} cancels"
msgstr "{yes} आयात; {esc} या {no} रद्द"

#. Confirmation box, removing the voice model: its heading.
msgctxt "confirm.removeVoices.title"
msgid "Remove voice model"
msgstr "आवाज़ मॉडल हटाएँ"

#. Confirmation box, removing the voice model: the question.
msgctxt "confirm.removeVoices.message"
msgid "Remove the voice model from this computer to free its space? Every Kinetic game uses it; you can download it again."
msgstr "जगह खाली करने के लिए इस कंप्यूटर से आवाज़ मॉडल हटाएँ? हर Kinetic गेम इसका उपयोग करता है; आप इसे फिर से डाउनलोड कर सकते हैं।"

#. Confirmation box, removing the voice model: the confirming button (short).
msgctxt "confirm.removeVoices.button"
msgid "Remove"
msgstr "हटाएँ"

#. Confirmation box, removing the voice model: the keys under the buttons.
#. Placeholders: {yes}, {esc}, {no}.
msgctxt "confirm.removeVoices.hint"
msgid "{yes} removes; {esc} or {no} cancels"
msgstr "{yes} हटाएँ; {esc} या {no} रद्द"

#. Decision screen: the last row, back to the story's main line.
msgctxt "choice.continue"
msgid "Return to main route"
msgstr "मुख्य रास्ते पर लौटें"

#. Decision screen: beside a route already played.
msgctxt "choice.seen"
msgid "seen"
msgstr "देखा गया"

#. Decision screen: the hint under the question.
msgctxt "choice.hint"
msgid "1-9 or click picks a route"
msgstr "1-9 या क्लिक से रास्ता चुनें"

#. Decision screen: the hint with more than nine routes ({enter} is the key).
#. Placeholders: {enter}.
msgctxt "choice.hintLong"
msgid "1-9, arrows and {enter}, or click picks a route"
msgstr "1-9, तीर कुंजियों और {enter}, या क्लिक से रास्ता चुनें"

#. Decision screen: added to the hint when the return row is there.
msgctxt "choice.hintContinue"
msgid "; 0 returns"
msgstr "; 0 से वापसी"

#. Decision screen: added to the hint while play-all is about to pick ({space} is the key).
#. Placeholders: {space}.
msgctxt "choice.hintAutoPick"
msgid "; {space} picks now"
msgstr "; {space} से अभी चुनें"

#. Decision screen, play-all: the countdown line; {seconds} left.
#. Placeholders: {seconds}.
msgctxt "choice.autoPick"
msgid "Play all routes picks in {seconds} s"
msgstr "“सभी रास्ते चलाएँ” {seconds} सेकंड में चुनेगा"

#. Decision screen, play-all, after a jump back: {label} is the route just finished (game text).
#. Placeholders: {label}, {seconds}.
msgctxt "choice.autoPickBack"
msgid "Back in time: “{label}” is done. Play all routes picks in {seconds} s"
msgstr "समय में वापस: “{label}” पूरा हुआ। “सभी रास्ते चलाएँ” {seconds} सेकंड में चुनेगा"

#. At an ending, top of the screen: everything has been seen.
msgctxt "endcard.allSeen"
msgid "You have seen everything."
msgstr "आपने सब कुछ देख लिया है।"

#. At an ending: no routes left, but other content unseen.
msgctxt "endcard.someUnseen"
msgid "Some content is still unseen."
msgstr "कुछ सामग्री अभी अनदेखी है।"

#. At an ending: {count} routes and other content unseen.
#. Placeholders: {count}.
#. Plural form "one" (CLDR), chosen by {count}.
msgctxt "endcard.routesAndOther#one"
msgid "{count} route and other content still unseen."
msgstr "{count} रास्ता और अन्य सामग्री अभी अनदेखी है।"

#. At an ending: {count} routes and other content unseen.
#. Placeholders: {count}.
#. Plural form "other" (CLDR), chosen by {count}.
msgctxt "endcard.routesAndOther#other"
msgid "{count} routes and other content still unseen."
msgstr "{count} रास्ते और अन्य सामग्री अभी अनदेखे हैं।"

#. At an ending: {count} routes unseen.
#. Placeholders: {count}.
#. Plural form "one" (CLDR), chosen by {count}.
msgctxt "endcard.routes#one"
msgid "{count} route still unseen."
msgstr "{count} रास्ता अभी अनदेखा है।"

#. At an ending: {count} routes unseen.
#. Placeholders: {count}.
#. Plural form "other" (CLDR), chosen by {count}.
msgctxt "endcard.routes#other"
msgid "{count} routes still unseen."
msgstr "{count} रास्ते अभी अनदेखे हैं।"

#. At an ending, under the count: the key to the next unseen content.
#. Placeholders: {key}.
msgctxt "endcard.next"
msgid "Press {key} for the next one."
msgstr "अगले के लिए {key} दबाएँ।"

#. On a resume, top of the screen: unseen content earlier on ({key} is U).
#. Placeholders: {key}.
msgctxt "endcard.earlierUnseen"
msgid "Earlier content you haven't seen - press {key}."
msgstr "पहले की कुछ सामग्री अनदेखी है - {key} दबाएँ।"

#. Pill: skip mode started.
msgctxt "pill.skipOn"
msgid "Skip on"
msgstr "छोड़ना चालू"

#. Pill: skip mode stopped.
msgctxt "pill.skipOff"
msgid "Skip off"
msgstr "छोड़ना बंद"

#. Pill: auto-forward turned on.
msgctxt "pill.autoForwardOn"
msgid "Auto-forward on"
msgstr "स्वतः आगे बढ़ना चालू"

#. Pill: auto-forward turned off.
msgctxt "pill.autoForwardOff"
msgid "Auto-forward off"
msgstr "स्वतः आगे बढ़ना बंद"

#. Pill: sound turned on.
msgctxt "pill.soundOn"
msgid "Sound on"
msgstr "ध्वनि चालू"

#. Pill: sound turned off.
msgctxt "pill.soundOff"
msgid "Sound off"
msgstr "ध्वनि बंद"

#. Pill: a bookmark was saved.
msgctxt "pill.bookmarked"
msgid "Bookmarked"
msgstr "बुकमार्क किया गया"

#. Pill: the story jumped back in time to take another route.
msgctxt "pill.backJump"
msgid "Back to try another route"
msgstr "दूसरा रास्ता आज़माने के लिए वापस"

#. Pill: the route just entered; {label} is its name (game text).
#. Placeholders: {label}.
msgctxt "pill.route"
msgid "Route: {label}"
msgstr "रास्ता: {label}"

#. Pill on a video with several camera views: which view, {index} of {count}.
#. Placeholders: {index}, {count}.
msgctxt "pill.segment"
msgid "View {index} of {count}"
msgstr "दृश्य {count} में से {index}"

#. Pill until the browser allows sound.
msgctxt "audio.soundHint"
msgid "Press any key for sound"
msgstr "ध्वनि के लिए कोई भी कुंजी दबाएँ"

#. Shown instead of a picture: the game folder has no items at all.
msgctxt "visual.empty"
msgid "No content yet — this folder has an empty manifest."
msgstr "अभी कोई सामग्री नहीं — इस फ़ोल्डर का मैनिफ़ेस्ट खाली है।"

#. Shown instead of a picture: nothing to draw here.
msgctxt "visual.nothing"
msgid "No content to show."
msgstr "दिखाने के लिए कोई सामग्री नहीं।"

#. Shown instead of a picture in a broken game: {id} is the item's identifier.
#. Placeholders: {id}.
msgctxt "visual.placeholder"
msgid "{id} — text item with no visual"
msgstr "{id} — बिना चित्र का टेक्स्ट आइटम"

#. Volumes sheet: its heading.
msgctxt "volumes.title"
msgid "Volumes"
msgstr "वॉल्यूम"

#. Volumes sheet: the key that closes it.
#. Placeholders: {esc}.
msgctxt "volumes.hint"
msgid "{esc} closes"
msgstr "{esc} से बंद करें"

#. Volumes sheet: the closing button.
msgctxt "volumes.done"
msgid "Done"
msgstr "हो गया"

#. Volumes sheet: the music row.
msgctxt "volumes.music"
msgid "Music"
msgstr "संगीत"

#. Volumes sheet: accessible name of the music slider.
msgctxt "volumes.music.slider"
msgid "Music volume"
msgstr "संगीत वॉल्यूम"

#. Volumes sheet: accessible name of the music minus button.
msgctxt "volumes.music.decrease"
msgid "Decrease music volume"
msgstr "संगीत वॉल्यूम घटाएँ"

#. Volumes sheet: accessible name of the music plus button.
msgctxt "volumes.music.increase"
msgid "Increase music volume"
msgstr "संगीत वॉल्यूम बढ़ाएँ"

#. Volumes sheet: the sound effects row.
msgctxt "volumes.effects"
msgid "Effects"
msgstr "प्रभाव"

#. Volumes sheet: accessible name of the effects slider.
msgctxt "volumes.effects.slider"
msgid "Effects volume"
msgstr "प्रभाव वॉल्यूम"

#. Volumes sheet: accessible name of the effects minus button.
msgctxt "volumes.effects.decrease"
msgid "Decrease effects volume"
msgstr "प्रभाव वॉल्यूम घटाएँ"

#. Volumes sheet: accessible name of the effects plus button.
msgctxt "volumes.effects.increase"
msgid "Increase effects volume"
msgstr "प्रभाव वॉल्यूम बढ़ाएँ"

#. Volumes sheet: the spoken lines row.
msgctxt "volumes.voice"
msgid "Voice"
msgstr "आवाज़"

#. Volumes sheet: accessible name of the voice slider.
msgctxt "volumes.voice.slider"
msgid "Voice volume"
msgstr "आवाज़ वॉल्यूम"

#. Volumes sheet: accessible name of the voice minus button.
msgctxt "volumes.voice.decrease"
msgid "Decrease voice volume"
msgstr "आवाज़ वॉल्यूम घटाएँ"

#. Volumes sheet: accessible name of the voice plus button.
msgctxt "volumes.voice.increase"
msgid "Increase voice volume"
msgstr "आवाज़ वॉल्यूम बढ़ाएँ"

#. Volumes sheet, Voice row: the small button that removes the installed voice model.
msgctxt "volumes.remove"
msgid "Remove voice model"
msgstr "आवाज़ मॉडल हटाएँ"

#. Volumes sheet: accessible name of the remove button.
msgctxt "volumes.removeAria"
msgid "Remove the voice model from this computer to free its space"
msgstr "जगह खाली करने के लिए इस कंप्यूटर से आवाज़ मॉडल हटाएँ"

#. Volumes sheet: accessible name of the "?" beside the voice model's download.
msgctxt "volumes.model.about"
msgid "About the voice model"
msgstr "आवाज़ मॉडल के बारे में"

#. Volumes sheet: accessible name of the voice model's download progress bar.
msgctxt "volumes.model.progress"
msgid "Voice model download"
msgstr "आवाज़ मॉडल डाउनलोड"

#. Volumes sheet: stops the voice model's download (short).
msgctxt "volumes.model.cancel"
msgid "Cancel"
msgstr "रद्द करें"

#. Volumes sheet: accessible name of the download's Cancel.
msgctxt "volumes.model.cancelAria"
msgid "Cancel the voice model download"
msgstr "आवाज़ मॉडल का डाउनलोड रद्द करें"

#. Volumes sheet: tries the failed download again (short).
msgctxt "volumes.model.retry"
msgid "Retry"
msgstr "फिर कोशिश करें"

#. Volumes sheet: accessible name of Retry.
msgctxt "volumes.model.retryAria"
msgid "Retry the voice model download"
msgstr "आवाज़ मॉडल का डाउनलोड फिर से आज़माएँ"

#. Volumes sheet, Voice row: until the game app says the voice model's state.
msgctxt "voice.checking"
msgid "Checking…"
msgstr "जाँच हो रही है…"

#. Volumes sheet, the voice model's "?": a computer that cannot make spoken lines.
msgctxt "voice.unsupported"
msgid "Spoken lines are not available on this computer."
msgstr "इस कंप्यूटर पर बोले गए संवाद उपलब्ध नहीं हैं।"

#. Volumes sheet: the voice model's download failed.
msgctxt "voice.failed"
msgid "The voice model could not be downloaded."
msgstr "आवाज़ मॉडल डाउनलोड नहीं हो सका।"

#. Volumes sheet: the download button; {size} is its size, e.g. 3.3 GB.
#. Placeholders: {size}.
msgctxt "voice.download"
msgid "Download voice model ({size})"
msgstr "आवाज़ मॉडल डाउनलोड करें ({size})"

#. Volumes sheet: the tip behind the download's "?"; {size} is its size.
#. Placeholders: {size}.
msgctxt "voice.help"
msgid "Spoken lines are made on this computer from the characters' voices. The voice model is downloaded once ({size}) and every Kinetic game on this computer shares it."
msgstr "बोले गए संवाद इसी कंप्यूटर पर पात्रों की आवाज़ों से बनाए जाते हैं। आवाज़ मॉडल एक बार डाउनलोड होता है ({size}) और इस कंप्यूटर के सभी Kinetic गेम इसे साझा करते हैं।"

#. Volumes sheet: a game app's voice problem the player has no words for; {text} is the general message above ("could not be downloaded" or "not available"), {detail} the app's own reason, in English.
#. Placeholders: {text}, {detail}.
msgctxt "voice.detail"
msgid "{text} ({detail})"
msgstr "{text} ({detail})"

#. Volumes sheet, the voice model's "?" (a Mac app): this Mac has an Intel processor.
msgctxt "voice.code.apple-silicon"
msgid "Spoken lines need a Mac with Apple silicon."
msgstr "बोले गए संवादों के लिए Apple silicon वाला Mac चाहिए।"

#. Volumes sheet, the voice model's "?" (a Mac app): {version} is the macOS version needed, e.g. 14.0.
#. Placeholders: {version}.
msgctxt "voice.code.macos-version"
msgid "Spoken lines need macOS {version} or later."
msgstr "बोले गए संवादों के लिए macOS {version} या उसके बाद का संस्करण चाहिए।"

#. Volumes sheet, the voice model's "?": the computer's operating system is too old for the voice packages.
msgctxt "voice.code.unsupported-system"
msgid "Spoken lines need a newer operating system on this computer."
msgstr "बोले गए संवादों के लिए इस कंप्यूटर पर नया ऑपरेटिंग सिस्टम चाहिए।"

#. Volumes sheet, the voice model's "?" (a Windows app): the PC has no NVIDIA graphics card.
msgctxt "voice.code.no-nvidia"
msgid "Spoken lines need an NVIDIA graphics card. This computer doesn't have one."
msgstr "बोले गए संवादों के लिए NVIDIA ग्राफ़िक्स कार्ड चाहिए। इस कंप्यूटर में ऐसा कार्ड नहीं है।"

#. Volumes sheet, the voice model's "?" (a Windows app): {version} is the NVIDIA driver version needed, e.g. 570.65.
#. Placeholders: {version}.
msgctxt "voice.code.nvidia-driver"
msgid "Spoken lines need NVIDIA driver {version} or later. Update the graphics driver to use them."
msgstr "बोले गए संवादों के लिए NVIDIA ड्राइवर {version} या उसके बाद का संस्करण चाहिए। इन्हें इस्तेमाल करने के लिए ग्राफ़िक्स ड्राइवर अपडेट करें।"

#. Volumes sheet: not enough disk space for the voice model; {need} and {free} are sizes, e.g. 7.8 GB.
#. Placeholders: {need}, {free}.
msgctxt "voice.code.disk-space"
msgid "Spoken lines need {need} of free disk space; this computer has {free} free. Free some space, then try again."
msgstr "बोले गए संवादों के लिए डिस्क पर {need} खाली जगह चाहिए; इस कंप्यूटर में {free} खाली है। कुछ जगह खाली करें, फिर दोबारा कोशिश करें।"

#. Volumes sheet: a part of the voice model's download failed (the network or the server).
msgctxt "voice.code.download-failed"
msgid "A download failed. Try again to continue it."
msgstr "एक डाउनलोड विफल रहा। उसे जारी रखने के लिए दोबारा कोशिश करें।"

#. Volumes sheet: a downloaded part of the voice model was damaged and was deleted.
msgctxt "voice.code.hash-mismatch"
msgid "A download did not match its checksum. Try again."
msgstr "एक डाउनलोड अपने चेकसम से मेल नहीं खाया। दोबारा कोशिश करें।"

#. Volumes sheet: installing the downloaded voice packages failed.
msgctxt "voice.code.pip-failed"
msgid "Installing the voice packages failed."
msgstr "आवाज़ पैकेज इंस्टॉल नहीं हो सके।"

#. Volumes sheet: the voice model's install failed for another reason.
msgctxt "voice.code.install-failed"
msgid "The voice install failed."
msgstr "आवाज़ इंस्टॉल नहीं हो सकी।"

#. Volumes sheet: the folder the voice model goes in could not be created or written.
msgctxt "voice.code.folder-failed"
msgid "The voice folder could not be written."
msgstr "आवाज़ फ़ोल्डर में लिखा नहीं जा सका।"

#. Volumes sheet: the program that makes spoken lines could not start.
msgctxt "voice.code.helper-failed"
msgid "The voice helper could not start."
msgstr "आवाज़ सहायक शुरू नहीं हो सका।"

#. Volumes sheet: the program that makes spoken lines stopped.
msgctxt "voice.code.helper-crashed"
msgid "The voice helper stopped unexpectedly."
msgstr "आवाज़ सहायक अचानक रुक गया।"

#. Volumes sheet: the voice setup inside the game app is damaged.
msgctxt "voice.code.lock-failed"
msgid "This app's voice setup cannot be read."
msgstr "इस ऐप की आवाज़ सेटिंग पढ़ी नहीं जा सकती।"

#. Branch map: its heading.
msgctxt "map.title"
msgid "Branch map"
msgstr "शाखा मानचित्र"

#. Branch map: the Spoilers switch, on (decisions not reached show their words).
msgctxt "map.spoilers.on"
msgid "Spoilers: On"
msgstr "स्पॉइलर: चालू"

#. Branch map: the Spoilers switch, off (the default).
msgctxt "map.spoilers.off"
msgid "Spoilers: Off"
msgstr "स्पॉइलर: बंद"

#. Branch map header button: go to the newest bookmark.
msgctxt "map.newest"
msgid "Newest bookmark"
msgstr "नवीनतम बुकमार्क"

#. Branch map header button: centre the view on where the reader is.
msgctxt "map.centre"
msgid "Centre"
msgstr "केंद्र"

#. Branch map header button: the map at full size, scrolling.
msgctxt "map.full"
msgid "Full size"
msgstr "पूरा आकार"

#. Branch map header button: the whole map fitted to the screen.
msgctxt "map.fit"
msgid "Fit"
msgstr "स्क्रीन में फ़िट"

#. Branch map: the hint on a header button; {key} is its key.
#. Placeholders: {key}.
msgctxt "map.shortcut"
msgid "shortcut: {key}"
msgstr "शॉर्टकट: {key}"

#. Branch map: the label under the reader's position marker (lower case).
msgctxt "map.here"
msgid "you are here"
msgstr "आप यहाँ हैं"

#. Branch map: the note after a bookmark's ×.
msgctxt "map.toast.deleted"
msgid "Bookmark deleted"
msgstr "बुकमार्क हटाया गया"

#. Branch map: the button in that note; {key} is its key (Z).
#. Placeholders: {key}.
msgctxt "map.toast.undo"
msgid "Undo ({key})"
msgstr "पूर्ववत करें ({key})"

#. Branch map: a bookmark card's accessible name; {time} is when it was made.
#. Placeholders: {time}.
msgctxt "map.card.label"
msgid "Bookmark {time}"
msgstr "बुकमार्क {time}"

#. Branch map: the newest bookmark card's accessible name.
#. Placeholders: {time}.
msgctxt "map.card.labelNewest"
msgid "Bookmark {time} (newest)"
msgstr "बुकमार्क {time} (नवीनतम)"

#. Branch map: a bookmark card's × (accessible name and hint).
msgctxt "map.card.delete"
msgid "Delete this bookmark"
msgstr "यह बुकमार्क हटाएँ"

#. Branch map: a deleted card, until it fades (short).
msgctxt "map.card.deleted"
msgid "Deleted"
msgstr "हटाया गया"

#. Branch map: brings a deleted card back (short).
msgctxt "map.card.undo"
msgid "Undo"
msgstr "पूर्ववत करें"

#. Branch map tooltip and accessible name: {title}, then {status}.
#. Placeholders: {title}, {status}.
msgctxt "map.node.label"
msgid "{title}: {status}"
msgstr "{title}: {status}"

#. Branch map tooltip: a route's title, {number}. {label} (label is game text).
#. Placeholders: {number}, {label}.
msgctxt "map.route.title"
msgid "{number}. {label}"
msgstr "{number}. {label}"

#. Branch map, a route's status: never entered.
msgctxt "map.route.unseen"
msgid "not seen"
msgstr "नहीं देखा"

#. Branch map, a route's status: entered, not finished.
msgctxt "map.route.partly"
msgid "partly seen"
msgstr "आंशिक रूप से देखा"

#. Branch map, a route's status: played through.
msgctxt "map.route.played"
msgid "played"
msgstr "खेला गया"

#. Branch map, a route's outcome: it joins the story again.
msgctxt "map.route.continues"
msgid "continues the story"
msgstr "कहानी जारी रखता है"

#. Branch map, a route's outcome: it comes back to its decision.
msgctxt "map.route.returns"
msgid "returns to the choice"
msgstr "चुनाव पर लौटता है"

#. Branch map, a route's outcome: it ends the story.
msgctxt "map.route.ends"
msgid "an ending"
msgstr "एक अंत"

#. Branch map, a route's status: the route last picked there.
msgctxt "map.route.lastPick"
msgid "your last pick"
msgstr "आपका पिछला चुनाव"

#. Branch map, a route's status: its decision not reached.
msgctxt "map.route.notReached"
msgid "decision not reached yet"
msgstr "चुनाव तक अभी नहीं पहुँचे"

#. Branch map, a decision's status: {played} of its {count} routes played.
#. Placeholders: {played}, {count}.
#. Plural form "one" (CLDR), chosen by {count}.
msgctxt "map.decision.played#one"
msgid "{played} of {count} routes played"
msgstr "{count} में से {played} रास्ता खेला गया"

#. Branch map, a decision's status: {played} of its {count} routes played.
#. Placeholders: {played}, {count}.
#. Plural form "other" (CLDR), chosen by {count}.
msgctxt "map.decision.played#other"
msgid "{played} of {count} routes played"
msgstr "{count} में से {played} रास्ते खेले गए"

#. Branch map, a decision's status: not reached yet.
msgctxt "map.decision.notReached"
msgid "not reached yet"
msgstr "अभी नहीं पहुँचे"

#. Branch map, Spoilers off: stands for a decision's question not reached.
msgctxt "map.hidden.prompt"
msgid "Decision not reached"
msgstr "चुनाव तक नहीं पहुँचे"

#. Branch map, Spoilers off: stands for a route's name not reached.
msgctxt "map.hidden.route"
msgid "Unseen route"
msgstr "अनदेखा रास्ता"

#. Branch map, beside a stretch of story: its length in screens.
#. Placeholders: {count}.
#. Plural form "one" (CLDR), chosen by {count}.
msgctxt "map.count.screens#one"
msgid "{count} screen"
msgstr "{count} स्क्रीन"

#. Branch map, beside a stretch of story: its length in screens.
#. Placeholders: {count}.
#. Plural form "other" (CLDR), chosen by {count}.
msgctxt "map.count.screens#other"
msgid "{count} screens"
msgstr "{count} स्क्रीन"

#. Branch map, beside a stretch of story: its bookmarks.
#. Placeholders: {count}.
#. Plural form "one" (CLDR), chosen by {count}.
msgctxt "map.count.bookmarks#one"
msgid "{count} bookmark"
msgstr "{count} बुकमार्क"

#. Branch map, beside a stretch of story: its bookmarks.
#. Placeholders: {count}.
#. Plural form "other" (CLDR), chosen by {count}.
msgctxt "map.count.bookmarks#other"
msgid "{count} bookmarks"
msgstr "{count} बुकमार्क"

#. Import refused: the file is not JSON.
msgctxt "transfer.notJson"
msgid "That file is not a Kinetic progress file (it is not JSON)."
msgstr "यह फ़ाइल Kinetic प्रगति फ़ाइल नहीं है (यह JSON नहीं है)।"

#. Import refused: the file is JSON but not a progress file.
msgctxt "transfer.notProgress"
msgid "That file is not a Kinetic progress file."
msgstr "यह फ़ाइल Kinetic प्रगति फ़ाइल नहीं है।"

#. Import refused: another file version; {theirs} as written in it, {ours} a number.
#. Placeholders: {theirs}, {ours}.
msgctxt "transfer.version"
msgid "That progress file is version {theirs}; this player reads version {ours}."
msgstr "यह प्रगति फ़ाइल संस्करण {theirs} की है; यह प्लेयर संस्करण {ours} पढ़ता है।"

#. Import refused: the file's story ID is damaged.
msgctxt "transfer.damaged.storyId"
msgid "That progress file is damaged: its story ID is missing or malformed."
msgstr "यह प्रगति फ़ाइल क्षतिग्रस्त है: इसकी कहानी ID गायब या ग़लत है।"

#. Import refused: the file's saved state is damaged.
msgctxt "transfer.damaged.state"
msgid "That progress file is damaged: its state is missing or malformed."
msgstr "यह प्रगति फ़ाइल क्षतिग्रस्त है: इसकी सहेजी गई स्थिति गायब या ग़लत है।"

#. Import refused: the file's bookmarks are damaged.
msgctxt "transfer.damaged.bookmarks"
msgid "That progress file is damaged: its bookmarks are missing or malformed."
msgstr "यह प्रगति फ़ाइल क्षतिग्रस्त है: इसके बुकमार्क गायब या ग़लत हैं।"

#. Import refused: another game's file; {theirs} and {here} name the two games (the phrases below).
#. Placeholders: {theirs}, {here}.
msgctxt "transfer.otherStory"
msgid "That file holds progress for {theirs}, not {here}."
msgstr "इस फ़ाइल में {here} की नहीं, {theirs} की प्रगति है।"

#. Names a game by its title in the message above; {title} is game text.
#. Placeholders: {title}.
msgctxt "transfer.story.titled"
msgid "\"{title}\""
msgstr "“{title}”"

#. Names a game by its story ID in the message above.
#. Placeholders: {id}.
msgctxt "transfer.story.id"
msgid "the story \"{id}\""
msgstr "कहानी “{id}”"

#. Names a file's game that has neither title nor ID, in the message above.
msgctxt "transfer.story.noId"
msgid "a story without an ID"
msgstr "बिना ID की एक कहानी"

#. Names this game, untitled, in the message above.
msgctxt "transfer.story.this"
msgid "this story"
msgstr "इस कहानी"

#. Mac app menu (the menu named after the game): hides the app; {title} is the game's title.
#. Placeholders: {title}.
msgctxt "host.menu.hide"
msgid "Hide {title}"
msgstr "{title} छिपाएँ"

#. Mac app menu (the menu named after the game): quits the app; {title} is the game's title.
#. Placeholders: {title}.
msgctxt "host.menu.quit"
msgid "Quit {title}"
msgstr "{title} बंद करें"

#. Mac app: the View menu's name in the menu bar.
msgctxt "host.menu.view"
msgid "View"
msgstr "दृश्य"

#. Mac app, View menu: reloads the game's page (the reader keeps their place).
msgctxt "host.menu.reload"
msgid "Reload"
msgstr "फिर से लोड करें"

#. Mac app, View menu: switches between full screen and a window (macOS's own wording).
msgctxt "host.menu.fullScreen"
msgid "Toggle Full Screen"
msgstr "पूर्ण स्क्रीन चालू/बंद करें"

#. Mac app, an alert before the game opens: the app is not in its game folder; {title} is the game's title.
#. Placeholders: {title}.
msgctxt "host.mac.missing.title"
msgid "{title} cannot find its game."
msgstr "{title} को अपना गेम नहीं मिल रहा।"

#. Mac app, the alert above: what to do; {file} is the page's file name (index.html), kept as written.
#. Placeholders: {file}.
msgctxt "host.mac.missing.text"
msgid "This app plays the {file} file in the folder it sits in, and there is none next to it. Keep the app inside its game folder. If the game folder was downloaded, open {file} in it instead."
msgstr "यह ऐप उस फ़ोल्डर की {file} फ़ाइल चलाता है जिसमें यह रखा है, और इसके पास ऐसी कोई फ़ाइल नहीं है। ऐप को उसके गेम फ़ोल्डर के अंदर ही रखें। अगर गेम फ़ोल्डर डाउनलोड किया गया था, तो इसके बजाय उसमें {file} खोलें।"

#. Mac app, the alert above: its only button, which quits the app.
msgctxt "host.mac.missing.quit"
msgid "Quit"
msgstr "बंद करें"

#. Windows program, an error box before the game opens: the program is not in its game folder; {title} is the game's title, {file} the page's file name (index.html), kept as written; the blank line stays.
#. Placeholders: {title}, {file}.
msgctxt "host.windows.missing"
msgid ""
"{title} cannot find {file} next to this program.\n"
"\n"
"Keep the program inside its game folder, or open the folder's {file} instead."
msgstr ""
"{title} को इस प्रोग्राम के पास {file} नहीं मिल रही।\n"
"\n"
"प्रोग्राम को उसके गेम फ़ोल्डर के अंदर ही रखें, या इसके बजाय फ़ोल्डर की {file} खोलें।"
